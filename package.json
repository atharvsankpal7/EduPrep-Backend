    "dev": "nodemon src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed:admin": "ts-node src/utils/seedAdmin.ts",
    "start": "node src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:pg": "docker run --name megaproj-pg -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=megaproject -p 5432:5432 -v megaproj_pg_data:/var/lib/postgresql/data -d postgres:17",
    "db:pg:start": "docker start megaproj-pg",
    "db:pg:up": "docker start megaproj-pg || pnpm db:pg",
    "db:truncate": "ts-node --files src/migrations/truncatePg.ts",
    "db:seed:constants": "ts-node --files src/migrations/seedConstants.ts"
  },
